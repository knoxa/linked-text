<?xml version="1.0"?>

<project name="GAO" basedir=".">

	<property file="ant.properties"/>

	<description>
		Georgian Officers Database.
	</description>
	
	<target name="group-rows" description="Group together input records for the same person">
		<xslt in="results/latest-67.xml" out="${data}/person-67th.xml" style="xsl/group.xsl" force="true">
			<param name="dataset" expression="file://${data}/67th.xml"/>
		</xslt>
	</target>
	
	<target name="make-sortable">
		<xslt in="${data}/person-67th.xml" out="${data}/sortable.xml" style="xsl/make-sortable.xsl" force="true"/>
	</target>
	
	<target name="sort">
		<xslt in="${data}/sortable.xml" out="${data}/sorted.xml" style="xsl/sort.xsl" force="true"/>
	</target>
	
	<target name="filter">
		<xslt in="${data}/sorted.xml" out="${data}/filtered.xml" style="xsl/filter.xsl" force="true"/>
	</target>
	
	<target name="select">
		<xslt in="${data}/filtered.xml" out="${data}/selected.xml" style="xsl/select.xsl" force="true"/>
	</target>
	
	<target name="make-context">
		<xslt in="${data}/selected.xml" out="/C:/workspaces/development/Tigers/GAO/hypotheses/all.xml" style="xsl/context.xsl" force="true"/>
	</target>
	
	<target name="check">
		<xslt in="${data}/filtered.xml" out="${data}/checked.xml" style="xsl/check-fileyear.xsl" force="true"/>
	</target>

</project>
